    {
      "id": "claim_14a7d00476d049208af0a07765b46dcd",
      "statement": "The per-chunk ACK flow is stop-and-wait per channel: sender publishes FileMetadata on channel[0] and moves to WaitingAccept; on the receiver's EVENT_RECEIVER_ACCEPT it starts each channel's loop sending FilePartMetaData; the first chunk on a channel is sent only after that channel's EVENT_RECEIVED_FILE_PART_METADATA; each sent chunk is acknowledged by the receiver's EVENT_RECEIVED_CHUNK which triggers the next chunk; when all parts finish, the SendingFile becomes Success.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L66-L95",
          "version": "repo-lines-v1:sha256:df1a7c87ba1b406b2addfd3df3c6fbb0ab6a2104be58d8a8b6ba36e0765136e2:"
