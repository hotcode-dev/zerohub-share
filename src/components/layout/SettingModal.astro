---
import Cog from "../icons/Cog.astro";
---

<button
  type="button"
  aria-label="Open settings"
  class="btn btn-ghost min-h-[44px] min-w-[44px] gap-2 rounded-xl px-3 text-base-content/80 hover:bg-base-200 hover:text-base-content"
  onclick="settingmodal.showModal()"
>
  <Cog />
  <span class="hidden text-sm font-medium sm:inline">Settings</span>
</button>

<dialog id="settingmodal" class="modal modal-bottom sm:modal-middle">
  <div
    class="modal-box border border-base-300 bg-base-100 p-6 shadow-xl sm:max-w-md sm:rounded-2xl"
  >
    <div class="flex items-center justify-between border-b border-base-300 pb-4">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-base-content">
          Settings
        </h2>
        <span class="mt-1 block text-sm leading-normal text-base-content/75">
          Configure your peer identity and WebRTC transfer options.
        </span>
      </div>
      <form method="dialog">
        <button
          type="submit"
          aria-label="Close settings"
          class="btn btn-ghost btn-circle min-h-[44px] min-w-[44px] text-base-content/70 hover:bg-base-200 hover:text-base-content"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </form>
    </div>

    <div class="flex flex-col gap-4 py-5">
      <label
        for="darkmode-toggle"
        class="flex min-h-[48px] cursor-pointer items-center justify-between rounded-xl border border-base-300 bg-base-200/60 px-4 py-3"
      >
        <span class="text-base font-medium text-base-content">
          Dark appearance
        </span>
        <input
          type="checkbox"
          name="darkMode"
          class="toggle toggle-primary"
          id="darkmode-toggle"
        />
      </label>

      <div class="form-control w-full gap-2">
        <label for="name-input" class="text-sm font-medium text-base-content">
          Display name
        </label>
        <input
          type="text"
          name="displayName"
          placeholder="e.g. Alex Rivera…"
          class="input input-bordered min-h-[44px] w-full rounded-xl bg-base-100 text-base leading-normal focus:border-primary"
          id="name-input"
          autocomplete="nickname"
          spellcheck="false"
        />
      </div>

      <div class="form-control w-full gap-2">
        <label for="ice-input" class="text-sm font-medium text-base-content">
          ICE server (STUN / TURN)
        </label>
        <input
          type="text"
          name="iceServer"
          placeholder="stun:stun.l.google.com:19302, turn:…"
          class="input input-bordered min-h-[44px] w-full rounded-xl bg-base-100 font-mono text-base leading-normal focus:border-primary"
          id="ice-input"
          autocomplete="off"
          spellcheck="false"
        />
        <span class="text-xs text-base-content/65">
          Comma-separated URLs. Add a TURN server for 4G/5G cellular or strict
          NAT networks.
        </span>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="form-control w-full gap-1.5">
          <label
            for="ice-username-input"
            class="text-sm font-medium text-base-content"
          >
            TURN username
          </label>
          <input
            type="text"
            name="iceUsername"
            placeholder="Optional"
            class="input input-bordered min-h-[44px] w-full rounded-xl bg-base-100 font-mono text-base leading-normal focus:border-primary"
            id="ice-username-input"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div class="form-control w-full gap-1.5">
          <label
            for="ice-credential-input"
            class="text-sm font-medium text-base-content"
          >
            TURN credential
          </label>
          <input
            type="password"
            name="iceCredential"
            placeholder="Optional"
            class="input input-bordered min-h-[44px] w-full rounded-xl bg-base-100 font-mono text-base leading-normal focus:border-primary"
            id="ice-credential-input"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>

      <div class="form-control w-full gap-2">
        <label
          for="size-per-channel-input"
          class="text-sm font-medium text-base-content"
        >
          Size per data channel (MB)
        </label>
        <input
          type="number"
          name="sizePerChannel"
          inputmode="numeric"
          min="1"
          step="1"
          placeholder="25"
          class="input input-bordered min-h-[44px] w-full rounded-xl bg-base-100 font-mono text-base leading-normal focus:border-primary"
          id="size-per-channel-input"
        />
      </div>

      <label
        for="auto-download-input"
        class="flex min-h-[48px] cursor-pointer items-center justify-between rounded-xl border border-base-300 bg-base-200/60 px-4 py-3"
      >
        <span class="text-base font-medium text-base-content">
          Auto-download received files
        </span>
        <input
          type="checkbox"
          name="autoDownload"
          class="toggle toggle-primary"
          id="auto-download-input"
        />
      </label>
    </div>

    <div class="modal-action mt-0 flex items-center justify-between border-t border-base-300 pt-4">
      <button
        type="button"
        class="btn btn-ghost min-h-[44px] rounded-xl text-error hover:bg-error/10"
        id="reset-button"
      >
        Reset defaults
      </button>
      <div class="flex items-center gap-2">
        <form method="dialog">
          <button
            type="submit"
            class="btn btn-ghost min-h-[44px] rounded-xl"
          >
            Cancel
          </button>
        </form>
        <button
          type="button"
          class="btn btn-primary min-h-[44px] rounded-xl px-5"
          id="save-button"
        >
          Save changes
        </button>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit" aria-label="Close settings backdrop">close</button>
  </form>
</dialog>

<script>
  const localDarkKey = "darkMode";
  let localDarkMode = localStorage.getItem(localDarkKey);
  let darkMode = false;

  switch (localDarkMode) {
    case "true":
      darkMode = true;
      break;
    case "false":
      darkMode = false;
      break;
    case null:
      darkMode =
        window?.matchMedia?.("(prefers-color-scheme:dark)")?.matches || false;
  }

  const modalToggle = document.getElementById(
    "darkmode-toggle",
  ) as HTMLInputElement;

  function setTheme(isDark: boolean) {
    darkMode = isDark;
    if (modalToggle) modalToggle.checked = isDark;
    localStorage.setItem(localDarkKey, isDark ? "true" : "false");
    document
      ?.querySelector("html")
      ?.setAttribute("data-theme", isDark ? "dark" : "light");
    const themeMeta = document.getElementById("theme-color-meta");
    if (themeMeta) {
      themeMeta.setAttribute("content", isDark ? "#09090B" : "#F8FAFC");
    }
  }

  if (modalToggle) {
    modalToggle.onchange = () => setTheme(modalToggle.checked);
  }

  setTheme(darkMode);

  import { defaultSetting, settingAtom } from "../../stores/setting";

  const nameInput = document.getElementById("name-input") as HTMLInputElement;
  const iceInput = document.getElementById("ice-input") as HTMLInputElement;
  const iceUsernameInput = document.getElementById(
    "ice-username-input",
  ) as HTMLInputElement;
  const iceCredentialInput = document.getElementById(
    "ice-credential-input",
  ) as HTMLInputElement;
  const sizePerChannelInput = document.getElementById(
    "size-per-channel-input",
  ) as HTMLInputElement;
  const autoDownloadInput = document.getElementById(
    "auto-download-input",
  ) as HTMLInputElement;

  const saveButton = document.getElementById(
    "save-button",
  ) as HTMLButtonElement;
  const resetButton = document.getElementById(
    "reset-button",
  ) as HTMLButtonElement;

  settingAtom.subscribe((s) => {
    nameInput.value = s.name;
    iceInput.value = s.iceServer;
    iceUsernameInput.value = s.iceUsername ?? "";
    iceCredentialInput.value = s.iceCredential ?? "";
    sizePerChannelInput.value = Math.max(
      1,
      Math.round(s.bytesPerDataChannel / (1024 * 1024)),
    ).toString();
    autoDownloadInput.checked = s.autoDownload;
  });

  saveButton.onclick = (e) => {
    e.preventDefault();
    const parsedSizePerChannel = Number(sizePerChannelInput.value);
    const chunkBytes =
      Number.isFinite(parsedSizePerChannel) && parsedSizePerChannel > 0
        ? Math.round(parsedSizePerChannel * 1024 * 1024)
        : defaultSetting.bytesPerDataChannel;
    settingAtom.set({
      name: nameInput.value.trim() || defaultSetting.name,
      iceServer: iceInput.value.trim() || defaultSetting.iceServer,
      iceUsername: iceUsernameInput.value.trim(),
      iceCredential: iceCredentialInput.value.trim(),
      bytesPerDataChannel: chunkBytes,
      autoDownload: autoDownloadInput.checked,
    });
    window.location.reload();
  };

  resetButton.onclick = (e) => {
    e.preventDefault();
    nameInput.value = defaultSetting.name;
    iceInput.value = defaultSetting.iceServer;
    iceUsernameInput.value = defaultSetting.iceUsername ?? "";
    iceCredentialInput.value = defaultSetting.iceCredential ?? "";
    sizePerChannelInput.value = Math.round(
      defaultSetting.bytesPerDataChannel / (1024 * 1024),
    ).toString();
    autoDownloadInput.checked = defaultSetting.autoDownload;
  };
</script>
